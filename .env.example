# App connects as bp_app (NOBYPASSRLS) so Row-Level Security is always enforced.
DATABASE_URL=postgresql+psycopg://bp_app:bp_app_dev@localhost:5432/batchpilot
# Migrations and the demo seed run as the table owner.
MIGRATION_DATABASE_URL=postgresql+psycopg://bp_owner:bp_owner_dev@localhost:5432/batchpilot
ENV=local
# In local/dev the OTP is returned in the API response and logged, no SMS is sent.
DEV_OTP_ECHO=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Cross-tenant jobs (reconciliation, outbox worker) use a BYPASSRLS role.
OPS_DATABASE_URL=postgresql+psycopg://bp_ops:bp_ops_dev@localhost:5432/batchpilot

# SMS: console (log only) | android_gateway (free, your phone's SIM) | bulksmsbd (paid, production)
SMS_PROVIDER=console
# "SMS Gateway for Android" app → Cloud server → copy username/password here.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# bulksmsbd.net dashboard → API key and approved sender ID.
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
